# Path to the source Excel file with PNRs and Last Names
INPUT_EXCEL_PATH=Etihad passenger details 9th Aug.xlsx

# Path where the output Excel file will be saved
OUTPUT_EXCEL_PATH=Etihad passenger details 9th Aug_Processed.xlsx

# Browser headless mode (true/false)
HEADLESS=false

# Default timeout in milliseconds for Playwright operations
TIMEOUT=45000
